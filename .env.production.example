# ==============================================================================
# CloudProof Production Environment Configuration Template
# Copy this file to .env.production before deploying:
#   cp .env.production.example .env.production
# ==============================================================================

# Application Environment
ENVIRONMENT=production
LOG_LEVEL=INFO

# Networking & Ports
HTTP_PORT=80
CORS_ORIGINS=http://localhost,http://127.0.0.1

# PostgreSQL Production Database (Auto-configured in docker-compose.prod.yml)
POSTGRES_USER=cloudproof_admin
POSTGRES_PASSWORD=generate_a_secure_random_db_password_here_123!
POSTGRES_DB=cloudproof_production

# JWT Authentication Security (Generate using: openssl rand -hex 32)
JWT_SECRET=generate_a_cryptographically_secure_random_key_min_32_characters_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Rate Limiting Guardrails
RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT=10
VERIFY_RATE_LIMIT=20
RATE_LIMIT_WINDOW_SECONDS=60

# AI Post-Mortem Engine (Optional: Leave blank to use DeterministicOfflineLLMProvider with zero cloud cost)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# AWS Real Mode Verification (Optional: used for student cross-account STS AssumeRole verification)
AWS_REGION=us-east-1
AWS_ASSUME_ROLE_ENABLED=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=/api/v1

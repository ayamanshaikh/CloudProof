# ==============================================================================
# CloudProof Environment Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Configuration (PostgreSQL)
# Format: postgresql+asyncpg://<username>:<password>@<host>:<port>/<database>
DATABASE_URL=postgresql+asyncpg://cloudproof_user:cloudproof_pass@localhost:5432/cloudproof_db

# Security & Authentication (JWT)
# Generate a strong 256-bit secret using: openssl rand -hex 32
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_at_least_32_chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# AWS Integration (For Real AWS Mode verification)
AWS_REGION=us-east-1
# Set if CloudProof runs with an IAM role that assumes student roles
AWS_ASSUME_ROLE_ENABLED=true

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
